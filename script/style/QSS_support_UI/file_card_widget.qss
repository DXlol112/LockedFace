/* file_card_widget.py */
QFrame#file_card {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid gray;
    border-radius: 10px;
}

QFrame#file_card[selected="true"] {
    border: 3px solid green;
}

QFrame#file_card[deletePending="true"] {
    border: 3px solid red;
}

QFrame#file_card QLabel#file_card_name {
    border: none;
}
